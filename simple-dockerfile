    echo "MINIO_ACCESS_KEY=MrKxgiZXGyBArDz8bEnl" >> .env && \
    echo "MINIO_SECRET_KEY=DJnTcMpypd6x75DlQfCM2MocFIjRON0jU06OgKnn" >> .env && \
