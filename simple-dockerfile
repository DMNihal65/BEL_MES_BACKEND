# Create a simple test server file
RUN echo "from http.server import HTTPServer, BaseHTTPRequestHandler" > test_server.py && \
    echo "class Handler(BaseHTTPRequestHandler):" >> test_server.py && \
    echo "    def do_GET(self):" >> test_server.py && \
    echo "        self.send_response(200)" >> test_server.py && \
    echo "        self.send_header('Content-type', 'text/html')" >> test_server.py && \
    echo "        self.end_headers()" >> test_server.py && \
    echo "        self.wfile.write(b'Hello from BEL MES Backend!')" >> test_server.py && \
    echo "        print('Received request')" >> test_server.py && \
    echo "print('Starting server on port 8002...')" >> test_server.py && \
    echo "server = HTTPServer(('0.0.0.0', 8002), Handler)" >> test_server.py && \
    echo "print('Server started on port 8002')" >> test_server.py && \
    echo "server.serve_forever()" >> test_server.py

# Expose port 8002
EXPOSE 8002

# Command to run the test server
CMD ["python", "test_server.py"]
